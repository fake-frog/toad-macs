# ~/.blerc: ble.sh settings, mudpuddle colours (matches Emacs/Alacritty)

# ── Completion ───────────────────────────────────────────────────────────────
# Both of ble.sh's extra completion styles are off: no ghost-text
# auto-complete, and Tab shows the menu instead of cycling through it.
bleopt complete_auto_complete=
bleopt complete_menu_complete=
#bleopt complete_menu_style=info

# Only used if auto-complete is switched back on above.
bleopt complete_auto_delay=100
ble-bind -m auto_complete -f TAB auto_complete/insert
ble-bind -m auto_complete -f C-i auto_complete/insert

# ── Output ───────────────────────────────────────────────────────────────────
bleopt exec_elapsed_mark=   # no "[ble: elapsed ...]" after slow commands
bleopt exec_errexit_mark=   # no "[ble: exit N]" after failing commands

# ── Colours (mudpuddle) ──────────────────────────────────────────────────────
# Same roles as the Emacs theme: commands blue like function calls,
# builtins yellow, keywords violet, strings green, options aqua, errors red.

# Text and comments
ble-face -s syntax_default       fg=#c3c2b7
ble-face -s syntax_comment       fg=#898781,italic
ble-face -s syntax_quoted        fg=#55bf50
ble-face -s syntax_expr          fg=#c3c2b7
ble-face -s syntax_varname       fg=#c3c2b7
ble-face -s syntax_function_name fg=#6da7ec
ble-face -s syntax_error         fg=#ec7e7e
ble-face -s auto_complete        fg=#898781,italic   # ghost text, like comments
ble-face -s disabled             fg=#898781

# Commands
ble-face -s command_builtin   fg=#e6903a
ble-face -s command_keyword   fg=#a096eb
ble-face -s command_alias     fg=#6da7ec
ble-face -s command_function  fg=#6da7ec
ble-face -s command_file      fg=#6da7ec
ble-face -s command_directory fg=#6da7ec,bold        # like dired directories

# Arguments
ble-face -s argument_option     fg=#3bbd8c
ble-face -s argument_error      fg=#ec7e7e
ble-face -s filename_directory  fg=#c3c2b7
ble-face -s filename_executable fg=#c3c2b7
ble-face -s filename_other      fg=#c3c2b7

# Selection (like Emacs' region: blue tint, text keeps its colour)
ble-face -s region        bg=#2c3947
ble-face -s region_target bg=#292927
